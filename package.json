{
  "name": "local-atc-radar",
  "version": "0.4.0",
  "private": true,
  "description": "Local ATC Radar - Approach & Tower Scope",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/server.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -n \"SERVER,CLIENT,ELECTRON\" -c \"blue,green,magenta\" \"npm run server\" \"npm run client\" \"wait-on tcp:5173 && electron .\"",
    "app": "electron .",
    "pack": "npm run build && node scripts/package-win.js",
    "dist": "npm run pack",
    "start": "npm run dev"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^30.0.9",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.2.13",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.atc.localradar",
    "productName": "Local ATC Radar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        "dir",
        "portable"
      ]
    }
  }
}
